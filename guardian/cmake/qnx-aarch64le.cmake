#
# CMake toolchain for QNX SDP 8.0, aarch64le. Requires `source ~/qnx800/qnxsdp-env.sh`
# (sets QNX_HOST / QNX_TARGET and puts qcc on PATH).
# Verified 2026-11-06: QNX SDP 8.0.0 (q++ 12.2.0), CMake 3.28, Ubuntu 22.04 x86_64 host.

if(NOT DEFINED ENV{QNX_TARGET} OR NOT DEFINED ENV{QNX_HOST})
  message(FATAL_ERROR "QNX_TARGET/QNX_HOST not set: source qnxsdp-env.sh first")
endif()

set(CMAKE_SYSTEM_NAME QNX)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

set(QNX_COMPILER_TARGET gcc_ntoaarch64le)
set(CMAKE_C_COMPILER qcc)
set(CMAKE_C_COMPILER_TARGET ${QNX_COMPILER_TARGET})
set(CMAKE_CXX_COMPILER q++)
set(CMAKE_CXX_COMPILER_TARGET ${QNX_COMPILER_TARGET})

set(CMAKE_SYSROOT $ENV{QNX_TARGET})
set(CMAKE_FIND_ROOT_PATH $ENV{QNX_TARGET} $ENV{QNX_TARGET}/aarch64le)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
